# ===================================================
# Ether AI Voice Assistant - Offline Configuration
# ===================================================

# 🧠 Local LLM Provider Configuration
# Supported providers: ollama, llama_cpp, none
LLM_PROVIDER=ollama

# LLM model name (must be pre-downloaded)
# For Ollama: use 'ollama list' to see available models
# Recommended models: neural-chat, mistral, llama2, llama3.2
LLM_MODEL=neural-chat

# Local LLM endpoint (default for Ollama)
LLM_ENDPOINT=http://localhost:11434

# Generation timeout in seconds
LLM_TIMEOUT=30

# 🎙 Speech Recognition Configuration
# Whisper model size: tiny.en, base.en, small.en, medium.en
DEFAULT_WHISPER_MODEL=base.en

# Optional: Custom path to Whisper models (defaults to .cache/whisper/)
# WHISPER_MODEL_PATH=/path/to/models

# Ambient noise sensitivity threshold
ENERGY_THRESHOLD=400

# Wake-word detection threshold (percentage)
WAKE_SENSITIVITY=80

# ===================================================
# OFFLINE SETUP INSTRUCTIONS
# ===================================================
#
# 1. Install Ollama from https://ollama.ai
# 2. Download a model: ollama pull neural-chat
# 3. Verify: ollama list
# 4. (Optional) Pre-download Whisper models:
#    python -c "from faster_whisper import WhisperModel; WhisperModel('base.en')"
#
# For air-gapped deployment:
# 1. Pre-install all dependencies on a connected machine
# 2. Download models: ollama pull neural-chat
# 3. Copy .cache/whisper/ directory
# 4. Transfer entire project to offline machine
# 5. Set WHISPER_MODEL_PATH if models are in custom location
# ===================================================
