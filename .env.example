# ===================================================
# Ether AI Voice Assistant - Configuration
# ===================================================

# 🎵 Spotify API Credentials (Optional - for Spotify media control)
# Get from https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback

# 🧠 Google Gemini API Key (Optional - for enhanced AI web research and synthesis)
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 🎙 Speech & Model Engine Defaults
DEFAULT_ENGINE=whisper          # 'whisper' or 'google'
DEFAULT_WHISPER_MODEL=base.en    # 'tiny.en', 'base.en', 'small.en'
ENERGY_THRESHOLD=400            # Ambient noise sensitivity threshold
WAKE_SENSITIVITY=80             # Wake-word detection threshold (percentage)
